# ============================================================
# Bimari Mitao Herbs - SERVER environment (copy to server/.env)
# NEVER commit server/.env or share real values.
# ============================================================

# --- General ---
NODE_ENV=development
PORT=5000
# URL where the React app is served (used for CORS and links in emails).
# Dev: http://localhost:5173   Production: https://your-domain
CLIENT_URL=http://localhost:5173
# true = Express also serves client/dist (single-host deployment). Leave false in development.
SERVE_CLIENT=false

# --- MongoDB (REQUIRED) ---
# Local MongoDB:   mongodb://127.0.0.1:27017/bimari_mitao
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bimari_mitao?retryWrites=true&w=majority
# (Atlas data lives in Atlas's cloud, not on your drive. Local data lives in the --dbpath you start mongod with.)
MONGODB_URI=mongodb://127.0.0.1:27017/bimari_mitao

# --- Auth (REQUIRED) ---
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- First admin account (used only by: npm run create-admin) ---
ADMIN_NAME=
ADMIN_EMAIL=
# min 10 characters, upper + lower case + number
ADMIN_PASSWORD=

# --- Email (REQUIRED for registration OTP and password reset) ---
# Gmail example: enable 2-Step Verification, then create an "App password" and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true only for port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Bimari Mitao Herbs <your-address@example.com>

# --- Razorpay (optional until you have keys; COD works without them) ---
# Use TEST keys (rzp_test_...) from Razorpay Dashboard > Account & Settings > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you choose when creating the webhook in the Razorpay dashboard
# (URL: https://<your-public-domain>/api/payments/webhook, events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudinary product image uploads ---
# Create a Cloudinary account, then copy these values from Dashboard > Programmable Media > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Logs (optional; defaults to <project>/.local/logs) ---
# LOG_DIR=
