# ============================================================
# Bimari Mitao Herbs - CLIENT environment (copy to client/.env)
# Only variables starting with VITE_ are exposed to the browser. NEVER put secrets here.
# ============================================================

# Development only: where the Vite dev server forwards /api requests (your Express server).
VITE_DEV_API_TARGET=http://localhost:5000

# Production only, and ONLY if the API is on a different domain than the website.
# Leave empty when Express serves the built site (SERVE_CLIENT=true) or a reverse proxy forwards /api.
# Note: cross-domain cookies need extra CORS/SameSite configuration; same-domain is strongly recommended.
VITE_API_BASE_URL=
